{
  "name": "automark",
  "version": "0.1.0",
  "private": true,
  "description": "AutoMark - local-first exam paper grading software for individual teachers",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @automark/server dev",
    "dev:web": "pnpm --filter @automark/web dev",
    "dev:vision": "node scripts/dev-vision.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
